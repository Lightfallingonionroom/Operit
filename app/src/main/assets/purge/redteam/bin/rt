def build_parser():
    p = argparse.ArgumentParser(prog="rt", description="dsh-purge 可移植红队工具层")
    p.add_argument("--human", action="store_true", help="紧凑文本输出")
    sub = p.add_subparsers(dest="cmd", required=True)

    e = sub.add_parser("engage", help="靶标")
    e.add_argument("action", choices=["open", "list", "info", "bind"])
    e.add_argument("--target")
    e.add_argument("--scope", nargs="*")
    e.add_argument("--engagement")
    e.set_defaults(func=cmd_engage)

    a = sub.add_parser("asset", help="资产台账")
    a.add_argument("action", choices=["add", "query", "get", "test", "assess", "stats"])
    a.add_argument("--ip")
    a.add_argument("--id")
    a.add_argument("--port", type=int)
    a.add_argument("--ports", help="JSON 数组：[{port,service,product,version,url,title}]")
    a.add_argument("--service")
    a.add_argument("--product")
    a.add_argument("--version")
    a.add_argument("--url")
    a.add_argument("--title")
    a.add_argument("--state")
    a.add_argument("--primary-name")
    a.add_argument("--provenance", choices=["passive", "active"])
    a.add_argument("--tool")
    a.add_argument("--names", nargs="*", help="域名列表")
    a.add_argument("--discovered-at")
    a.add_argument("--q")
    a.add_argument("--scope", choices=["internal", "external"])
    a.add_argument("--cidr")
    a.add_argument("--priority", choices=["high", "medium", "low"])
    a.add_argument("--sort", choices=["priority", "todo", "ports", "ip"])
    a.add_argument("--limit", type=int)
    a.add_argument("--status", choices=["untested", "testing", "tested", "blocked", "abandoned", "no_surface"])
    a.add_argument("--test")
    a.add_argument("--surface")
    a.add_argument("--blocked", action="store_true")
    a.add_argument("--potential")
    a.add_argument("--reason")
    a.add_argument("--by")
    a.set_defaults(func=cmd_asset)

    v = sub.add_parser("vuln", help="漏洞台账")
    v.add_argument("action", choices=["add", "query", "update"])
    v.add_argument("--id")
    v.add_argument("--title")
    v.add_argument("--severity", choices=["critical", "high", "medium", "low", "info"])
    v.add_argument("--cve")
    v.add_argument("--target")
    v.add_argument("--asset")
    v.add_argument("--evidence")
    v.add_argument("--gained")
    v.add_argument("--confidence", type=float, default=0.8)
    v.add_argument("--status", choices=["candidate", "confirmed", "false-positive", "exploited", "fixed"])
    v.add_argument("--source")
    v.add_argument("--q")
    v.add_argument("--limit", type=int)
    v.add_argument("--by")
    v.set_defaults(func=cmd_vuln)

    c = sub.add_parser("cred", help="凭据")
    c.add_argument("action", choices=["add", "list"])
    c.add_argument("--host")
    c.add_argument("--username")
    c.add_argument("--secret")
    c.add_argument("--type")
    c.add_argument("--privilege")
    c.add_argument("--source")
    c.add_argument("--tool")
    c.add_argument("--secret-ref")
    c.add_argument("--note")
    c.add_argument("--by")
    c.set_defaults(func=cmd_cred)

    ac = sub.add_parser("access", help="访问会话")
    ac.add_argument("action", choices=["add", "list"])
    ac.add_argument("--host")
    ac.add_argument("--method")
    ac.add_argument("--username")
    ac.add_argument("--privilege")
    ac.add_argument("--note")
    ac.add_argument("--session-ref")
    ac.add_argument("--by")
    ac.set_defaults(func=cmd_access)

    w = sub.add_parser("webshell", help="WebShell")
    w.add_argument("action", choices=["add", "list", "update"])
    w.add_argument("--id")
    w.add_argument("--url")
    w.add_argument("--type", choices=["behinder", "godzilla", "other"])
    w.add_argument("--pass-key")
    w.add_argument("--privilege")
    w.add_argument("--note")
    w.add_argument("--secret-ref")
    w.add_argument("--status", choices=["online", "offline", "dead", "unknown"])
    w.add_argument("--by")
    w.set_defaults(func=cmd_webshell)

    t = sub.add_parser("tunnel", help="隧道")
    t.add_argument("action", choices=["add", "list", "update"])
    t.add_argument("--id")
    t.add_argument("--kind", choices=["suo5", "socks5", "ssh-r", "frp", "chisel", "other"])
    t.add_argument("--listen")
    t.add_argument("--entry")
    t.add_argument("--reach")
    t.add_argument("--entry-kind", choices=["target-outbound", "target-http", "target-agent", "self-only"])
    t.add_argument("--command")
    t.add_argument("--status", choices=["active", "down", "closed", "unknown"])
    t.add_argument("--note")
    t.add_argument("--by")
    t.set_defaults(func=cmd_tunnel)

    s = sub.add_parser("session", help="会话总览 / 连通性")
    s.add_argument("action", choices=["check", "list"])
    s.set_defaults(func=cmd_session)

    ch = sub.add_parser("chain", help="攻击链")
    ch.add_argument("action", choices=["add", "list"])
    ch.add_argument("--seq", type=int)
    ch.add_argument("--stage-code", choices=["recon", "internet", "boundary", "internal", "target"])
    ch.add_argument("--title")
    ch.add_argument("--tool")
    ch.add_argument("--detail")
    ch.add_argument("--result")
    ch.add_argument("--agent")
    ch.add_argument("--target")
    ch.add_argument("--evidence-ref")
    ch.set_defaults(func=cmd_chain)

    sc = sub.add_parser("score", help="记分")
    sc.add_argument("action", choices=["list", "hit"])
    sc.add_argument("--code")
    sc.add_argument("--points", type=int)
    sc.add_argument("--target")
    sc.add_argument("--evidence")
    sc.add_argument("--note")
    sc.add_argument("--vuln-id", type=int)
    sc.add_argument("--step-id", type=int)
    sc.add_argument("--self-created", action="store_true")
    sc.add_argument("--by")
    sc.set_defaults(func=cmd_score)

    evp = sub.add_parser("evidence", help="HTTP 原始请求证据")
    evp.add_argument("action", choices=["add", "list"])
    evp.add_argument("--label")
    evp.add_argument("--url")
    evp.add_argument("--method")
    evp.add_argument("--status", type=int)
    evp.add_argument("--request")
    evp.add_argument("--response")
    evp.add_argument("--vuln-id", type=int)
    evp.add_argument("--note")
    evp.add_argument("--by")
    evp.set_defaults(func=cmd_evidence)

    poc = sub.add_parser("poc", help="POC 知识库")
    poc.add_argument("action", choices=["add", "search", "get"])
    poc.add_argument("--title")
    poc.add_argument("--code")
    poc.add_argument("--category")
    poc.add_argument("--component")
    poc.add_argument("--cve")
    poc.add_argument("--severity")
    poc.add_argument("--verified", action="store_true")
    poc.add_argument("--verified-note")
    poc.add_argument("--usage")
    poc.add_argument("--content")
    poc.add_argument("--source")
    poc.add_argument("--asset-target")
    poc.add_argument("--q")
    poc.add_argument("--by")
    poc.set_defaults(func=cmd_poc)

    pf = sub.add_parser("preflight", help="工具链与环境自检")
    pf.set_defaults(func=cmd_preflight)

    rp = sub.add_parser("report", help="生成复现报告")
    rp.add_argument("--markdown", action="store_true")
    rp.set_defaults(func=cmd_report)

    return p


def main():
    global HUMAN
    args = build_parser().parse_args()
    HUMAN = getattr(args, "human", False)
    DATA.mkdir(parents=True, exist_ok=True)
    args.func(args)


if __name__ == "__main__":
    main()
